# --- Core (existing) ----------------------------------------------------------
DATABASE_URL=postgres://nouvellesdupays:changeme@localhost:5432/nouvellesdupays
PORT=4000
POLL_SCHEDULE=*/5 * * * *
NEXT_PUBLIC_API_URL=http://localhost:4000

# Admin panel (generate the hash with:
#   node -e "console.log(require('./apps/api/src/adminAuth').hashPassword('your-password'))")
ADMIN_PASSWORD_HASH=
ADMIN_TOKEN_SECRET=

# --- Web (server-side rendering) ---------------------------------------------
# URL the Next.js server uses to reach the API (landing pages, sitemap).
# Optional; defaults to NEXT_PUBLIC_API_URL.
API_INTERNAL_URL=http://localhost:4000

# --- Tracking & consent (defaults; overridable in /admin/settings) -----------
TRACKING_ENABLED=true
# opt_in (UK/EU default: nothing collected before consent) | opt_out
CONSENT_MODE=opt_in
# true = log every tracking batch in the API logs + browser console
TRACKING_DEBUG=false
PUBLIC_SITE_URL=https://nouvellesdupays.com

# --- Meta (Facebook/Instagram) ----------------------------------------------
# Pixel ID: public (shown in the browser). Events Manager -> Data sources.
META_PIXEL_ID=
# SECRET. Conversions API token: Events Manager -> Settings -> Generate access token.
META_ACCESS_TOKEN=
# Only while testing: Events Manager -> Test events -> test code (e.g. TEST12345).
META_TEST_EVENT_CODE=
META_GRAPH_API_VERSION=v21.0

# --- YouTube ------------------------------------------------------------------
# SECRET, optional. Without it, metadata comes from keyless oEmbed (no
# description / publication date).
YOUTUBE_API_KEY=

# --- Worker: crawler for websites without feeds --------------------------------
CRAWL_MAX_ARTICLES_PER_RUN=20
CRAWL_DELAY_MS=1000
